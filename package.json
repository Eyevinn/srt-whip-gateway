{
  "name": "@eyevinn/srt-whip-gateway",
  "version": "0.4.0",
  "description": "SRT WHIP Gateway Service",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project ./",
    "build:ui": "parcel build src/ui/index.html",
    "dev": "NODE_ENV=development tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node --inspect ./dist/server.js\"",
    "dev:ui": "parcel -p 1234 --no-cache src/ui/index.html",
    "server": "node ./dist/server.js",
    "start": "npm run server",
    "postversion": "git push && git push --tags",
    "lint": "eslint .",
    "test": "jest"
  },
  "targets": {
    "main": false,
    "default": {
      "distDir": "./dist/ui",
      "publicUrl": "/ui"
    }
  },
  "author": "Eyevinn Technology <work@eyevinn.se>",
  "contributors": [
    "Jonas Birmé <jonas.birme@eyevinn.se> (Eyevinn Technology AB)"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.2.1",
    "@types/node": "^18.11.9",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.0",
    "jest": "^29.2.2",
    "mock-spawn": "^0.2.6",
    "parcel": "^2.7.0",
    "prettier": "3.9.10",
    "ts-jest": "^29.4.14",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.2.0",
    "fastify": "^5.12.5",
    "typebox": "^1.3.36",
    "winston": "^3.8.2"
  }
}
